{
  "name": "minecraft-schematic-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.6",
  "publisher": "jacklitstar",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacklitstar/vscode-litematic-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/jacklitstar/vscode-litematic-viewer/issues"
  },
  "homepage": "https://github.com/jacklitstar/vscode-litematic-viewer",
  "icon": "assets/icon.png",
  "license": "AGPL-3.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "minecraft",
    "nbt",
    "litematic",
    "schem",
    "mcstructure",
    "building gadgets",
    "schematic",
    "viewer"
  ],
  "activationEvents": [
    "onCustomEditor:minecraftSchematicViewer.viewer",
    "onCommand:minecraftSchematicViewer.openActiveFile"
  ],
  "main": "./dist/extension.cjs",
  "dependencies": {
    "deepslate": "0.24.0",
    "fflate": "0.8.2",
    "prismarine-nbt": "2.7.0"
  },
  "devDependencies": {
    "gl-matrix": "^3.4.3",
    "vite": "6.2.5"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "minecraftSchematicViewer.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.litematic"
          },
          {
            "filenamePattern": "*.schem"
          },
          {
            "filenamePattern": "*.nbt"
          },
          {
            "filenamePattern": "*.mcstructure"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "minecraftSchematicViewer.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "minecraftSchematicViewer.openActiveFile",
        "title": "%command.openActiveFile.title%"
      },
      {
        "command": "minecraftSchematicViewer.openResourcePacksFolder",
        "title": "%command.openResourcePacksFolder.title%"
      }
    ]
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config ./vite.extension.config.mjs",
    "build:webview": "vite build --config ./vite.webview.config.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "assets/**",
    "dist/**",
    "node_modules/**",
    "resources/**",
    "src/**",
    "vendor/**",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.nls*.json",
    "package.json"
  ]
}
